# ==============================================
# .gitignore — DCOMP320 Assignment 1
# ==============================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE / editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.DS_Store
Thumbs.db

# Test coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Pytest cache
.pytest_cache/

# Logs
*.log

# OS generated
.DS_Store
desktop.ini
